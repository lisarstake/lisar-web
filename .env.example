# ==============================================================================
# Lisar Monorepo - Global Environment Variables Template
# Copy relevant variables to apps/web/.env or apps/admin/.env
# ==============================================================================

# --- API & Environment Routing ---
VITE_ENV=development
VITE_API_BASE_URL=https://lisar-api-1.onrender.com/api/v1
VITE_API_BASE_URL_STAGING=https://lisar-api-1.onrender.com/api/v1
VITE_SITE_URL=http://localhost:5173

# --- Payments & Fiat On-Ramp (Web) ---
VITE_RAMP_API_BASE_URL=
VITE_RAMP_API_BASE_URL_STAGING=
VITE_PAJ_RAMP_API_BASE_URL=
VITE_PAJ_RAMP_API_BASE_URL_STAGING=
VITE_RAMP_API_KEY=
VITE_VIRTUAL_ACCOUNT_ID=
VITE_ONRAMP_APP_ID=

# --- Analytics (Web) ---
VITE_MIXPANEL_TOKEN=

# --- Supabase (Web) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- DeFi / Staking Pools (Maple Finance) (Web) ---
VITE_MAPLE_USDC_POOL_ID=
VITE_MAPLE_POOL_ID=

# --- Feature Flags / Mocks ---
VITE_USE_MOCK_BLOG=false
VITE_USE_MOCK_PUBLICATIONS=false
